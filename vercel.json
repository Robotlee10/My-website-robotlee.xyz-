{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www\\.robotlee\\.xyz"
        }
      ],
      "status": 301,
      "headers": {
        "Location": "https://robotlee.xyz/$1"
      }
    },
    {
      "src": "/?",
      "has": [
        {
          "type": "host",
          "value": "(?<folder>auto|cad|learn|repair|tools|web|portfolio|contact|encryptor|)\\.robotlee\\.xyz"
        }
      ],
      "dest": "/$folder/"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<folder>auto|cad|learn|repair|tools|web|portfolio|contact|encryptor)\\.robotlee\\.xyz"
        }
      ],
      "dest": "/$folder/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.robotlee\\.xyz"
        }
      ],
      "dest": "/404"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
